# Autonomous Trading System — credentials
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#
# Only TELEGRAM_* are needed to start. Everything else is optional.

# ---------------------------------------------------------------- Telegram
# From @BotFather (/newbot). Required for alerts and commands.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id, from @userinfobot. Commands are ONLY accepted from
# this id — anyone else messaging the bot is ignored and counted.
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------ dashboard access
# Required once the dashboard is reachable from the internet. Caddy presents
# these as Basic auth in front of the whole UI.
DASHBOARD_USER=trader
DASHBOARD_TOKEN=

# --------------------------------------------------------------- broker keys
# Read by the settings panel, or set here for a headless deployment.
# Leave blank to stay on the simulated paper broker.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# 'yes' is required before the LIVE Alpaca endpoint can be constructed. This
# exists so a stray config change cannot trade real money.
ALPACA_LIVE_CONFIRMED=

BINANCE_KEY_ID=
BINANCE_SECRET_KEY=
# 'yes' is required before the LIVE Binance endpoint can be constructed.
BINANCE_LIVE_CONFIRMED=

# Exness goes through MetaTrader 5, not a REST API:
#   login, password, and the server name (e.g. Exness-MT5Real8).
EXNESS_LOGIN=
EXNESS_PASSWORD=
EXNESS_SERVER=
